# Copy to .env.local. Never use a VITE_ prefix for API keys.
# Development uses Vite's /api proxy. Production needs the public backend URL.
VITE_AGENT_API_URL=

# Server only. Select a Responses API model available to your OpenAI account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://xinrantaoangela.github.io
DAILY_REQUEST_LIMIT=200
TRUST_PROXY=false
